#!/bin/sh
# Run the smoke test before every push; abort the push if it fails.
echo "pre-push: running smoke test ..."
cd "$(git rev-parse --show-toplevel)" || exit 1
.venv/Scripts/python.exe src/smoke_test.py
status=$?
if [ $status -ne 0 ]; then
    echo "pre-push: smoke test FAILED - push aborted."
    exit 1
fi
echo "pre-push: smoke test passed."
exit 0
