#!/bin/sh
# Check version sync and run the smoke test before every push; abort on failure.
cd "$(git rev-parse --show-toplevel)" || exit 1

echo "pre-push: checking version sync ..."
uv run python scripts/sync_version.py --check
if [ $? -ne 0 ]; then
    echo "pre-push: version drift - push aborted. Fix it with: uv run python scripts/sync_version.py"
    exit 1
fi

# Safety net: requirements.txt is a generated export (source of truth is
# uv.lock). Catch commits made with --no-verify or on a machine without the
# pre-commit hook. We regenerate to a temp file and compare -- never rewrite the
# committed file during a push.
echo "pre-push: checking requirements.txt is in sync with uv.lock ..."
req_tmp="$(mktemp 2>/dev/null || echo "${TMPDIR:-/tmp}/req-sync.$$")"
if ! uv export --no-hashes --no-dev -o "$req_tmp" >/dev/null 2>&1; then
    echo "pre-push: 'uv export' failed; cannot verify requirements.txt - push aborted."
    rm -f "$req_tmp"
    exit 1
fi
# Ignore CRLF/LF and the auto-generated header: its second line embeds the -o
# path, which is the temp file here vs requirements.txt in the committed copy.
strip_req() {
    tr -d '\r' < "$1" | grep -v -e '^# This file was autogenerated by uv' -e '^#    uv export'
}
if [ "$(strip_req requirements.txt)" != "$(strip_req "$req_tmp")" ]; then
    echo "pre-push: requirements.txt is OUT OF SYNC with uv.lock - push aborted."
    echo "  Regenerate it and commit the result:"
    echo "    uv export --no-hashes --no-dev -o requirements.txt"
    rm -f "$req_tmp"
    exit 1
fi
rm -f "$req_tmp"
echo "pre-push: requirements.txt in sync."

echo "pre-push: running smoke test ..."
uv run python src/smoke_test.py
status=$?
if [ $status -ne 0 ]; then
    echo "pre-push: smoke test FAILED - push aborted."
    exit 1
fi
echo "pre-push: smoke test passed."
exit 0
