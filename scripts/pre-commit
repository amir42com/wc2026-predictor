#!/bin/sh
# Keep the generated requirements.txt (the Streamlit Cloud install source) in
# sync with uv.lock at commit time. Source of truth is pyproject.toml + uv.lock;
# requirements.txt is a derived export, so we regenerate it and fold any change
# into the commit being created. Silent unless it actually re-syncs.
cd "$(git rev-parse --show-toplevel)" || exit 1

# Regenerate the export. A non-zero exit here is a real tooling error -> block
# the commit; a clean run that produces no change is the silent common case.
if ! uv export --no-hashes --no-dev -o requirements.txt >/dev/null 2>&1; then
    echo "pre-commit: 'uv export' failed; cannot sync requirements.txt - commit aborted." >&2
    exit 1
fi

# Act only if the regenerated file actually differs from what's staged. git diff
# normalizes CRLF/LF, so a Windows working copy never causes false churn.
if ! git diff --quiet -- requirements.txt; then
    git add requirements.txt
    echo "pre-commit: re-synced requirements.txt from uv.lock (added to this commit)."
fi

exit 0
